# ==========================================
# CONFIGURACIÓN DEL BOT DE DISCORD - PE:RP
# ==========================================

# 1. Coloca aquí el Token de tu Bot (Obtenlo en https://discord.com/developers/applications)
DISCORD_TOKEN=tu_token_de_bot_aqui

# 2. Client ID de tu Bot (Application ID en Discord Developer Portal)
CLIENT_ID=tu_client_id_aqui

# 3. ID de tu Servidor de Discord (Guild ID) para registrar los comandos al instante
GUILD_ID=tu_guild_id_aqui

# 4. URL de la Web Oficial de PE:RP
API_BASE_URL=https://ais-pre-iydhue5qk4b7wusoszmqp2-732238089491.us-east1.run.app

# 5. Conexión Directa a Supabase (Para sincronizar DNIs y Banco YA P en vivo entre Web y Bot)
# Copia la misma URL y Anon Key que configuraste en el Panel de Administración Web:
SUPABASE_URL=
SUPABASE_ANON_KEY=
