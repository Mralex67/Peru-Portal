# ==========================================
# CONFIGURACIÓN DEL BOT DE DISCORD - PE:RP
# ==========================================

# Token de tu Bot de Discord (Obtenlo en https://discord.com/developers/applications)
DISCORD_TOKEN=tu_token_de_bot_aqui

# Client ID de tu Bot (Application ID)
CLIENT_ID=tu_client_id_aqui

# ID del servidor de Discord (Guild ID) para registrar comandos al instante
GUILD_ID=tu_guild_id_aqui

# URL de la API del servidor Web PE:RP (Por defecto http://localhost:3000 o tu dominio)
API_BASE_URL=http://localhost:3000
