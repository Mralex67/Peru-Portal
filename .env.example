# ========================================================
# GOOGLE AI STUDIO ENVIRONMENT VARIABLES & SECRETS
# ========================================================
# Configura estas variables en Google AI Studio en:
# Publish > Secrets / Environment Variables

# GEMINI_API_KEY: Inyectado automáticamente por AI Studio si se requiere IA.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: La URL donde esta app está alojada (inyectada automáticamente por Cloud Run).
APP_URL="MY_APP_URL"

# --------------------------------------------------------
# 1. BASE DE DATOS SUPABASE (DNI RENIEC, ANTECEDENTES Y BANCO YA P)
# --------------------------------------------------------
# URL de tu proyecto Supabase (ej: https://xyzcompany.supabase.co)
SUPABASE_URL="https://tu-proyecto.supabase.co"
VITE_SUPABASE_URL="https://tu-proyecto.supabase.co"

# Anon Key pública de tu proyecto Supabase (Settings > API > Project API keys > anon public)
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# --------------------------------------------------------
# 2. DISCORD BOT & OAUTH CREDENTIALS (DISCORD DEVELOPER PORTAL)
# --------------------------------------------------------
# Token de tu Bot de Discord (Developer Portal > Bot > Reset Token)
DISCORD_TOKEN="MTI..."

# Client ID de tu aplicación (Developer Portal > General Information > Application ID)
DISCORD_CLIENT_ID="1105356730516377694"
VITE_DISCORD_CLIENT_ID="1105356730516377694"

# Client Secret de OAuth2 (Developer Portal > OAuth2 > General > Client Secret)
DISCORD_CLIENT_SECRET="tu_client_secret_aqui"

# ID del servidor oficial de Discord PE:RP
DISCORD_GUILD_ID="1554629558760775710"

# ID del Rol Policial PNP en el servidor de Discord
PNP_ROLE_ID="1555384968086032394"

# ID del Rol de Licencia de Conducir en Discord
LICENSE_ROLE_ID="1556723203114668082"

# --------------------------------------------------------
# 3. ROBLOX EMERGENCY RESPONSE: LIBERTY COUNTY (ER:LC)
# --------------------------------------------------------
# Server-Key de tu servidor en Roblox (Menú M > Settings > Developer/API)
ERLC_SERVER_KEY="tu_server_key_de_erlc"


